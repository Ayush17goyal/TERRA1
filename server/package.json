{
  "name": "legatrixon-server",
  "version": "1.0.0",
  "description": "Enterprise NestJS Core API Engine for LEGATRIXON",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.json --incremental false",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "validate:lexmentor": "npm run build && node dist/src/scripts/validate-lexmentor.js",
    "test": "jest --runInBand",
    "ingest": "npm run build && node dist/src/scripts/run-ingestion.js",
    "migrate:legal-corpus": "npm run build && node dist/src/scripts/legal-corpus-migration.js",
    "validate:parser": "ts-node -r tsconfig-paths/register src/scripts/extract-and-parse.ts --validate-only",
    "test:parser": "jest --runInBand src/modules/ingestion/indian-legal-parser.spec.ts",
    "extract:corpus": "ts-node -r tsconfig-paths/register src/scripts/extract-and-parse.ts",
    "extract:corpus:force": "ts-node -r tsconfig-paths/register src/scripts/extract-and-parse.ts --force",
    "sync:legal-corpus": "ts-node -r tsconfig-paths/register src/scripts/legal-corpus-sync.ts",
    "sync:legal-corpus:force": "ts-node -r tsconfig-paths/register src/scripts/legal-corpus-sync.ts --force",
    "validate:corpus": "ts-node -r tsconfig-paths/register src/scripts/legal-corpus-sync.ts --validate-only",
    "repair:corpus": "ts-node -r tsconfig-paths/register src/scripts/legal-corpus-sync.ts --repair-only",
    "test:sync": "jest --runInBand src/modules/ingestion/corpus-sync.spec.ts",
    "admin:hash-secret": "npm run build && node dist/src/scripts/hash-admin-secret.js",
    "admin:reset-dev": "npm run build && node dist/src/scripts/hash-admin-secret.js --update-dev-env"
  },
  "dependencies": {
    "@clerk/backend": "^3.5.0",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.3.0",
    "@nestjs/typeorm": "^10.0.1",
    "@nestjs/websockets": "^10.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@qdrant/js-client-rest": "^1.18.0",
    "@sentry/node": "^10.64.0",
    "@types/pdfkit": "^0.17.6",
    "@types/uuid": "^10.0.0",
    "adm-zip": "^0.5.17",
    "aws-sdk": "^2.1528.0",
    "axios": "^1.6.5",
    "bull": "^4.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.8.1",
    "docx": "^9.7.1",
    "dotenv": "^16.3.1",
    "helmet": "^8.2.0",
    "openai": "^6.42.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^3.11.174",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pptxgenjs": "^3.12.0",
    "prom-client": "^15.1.3",
    "redis": "^4.6.12",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "sqlite3": "^5.1.7",
    "tesseract.js": "^5.1.1",
    "typeorm": "^0.3.19",
    "uuid": "^14.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.0",
    "@nestjs/schematics": "^10.2.0",
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ]
  }
}
