# LEGATRIXON Backend Environment Variables
# Render Web Service root directory: server
# Do not commit real secrets. Do not expose service role keys to the frontend.

# Node & deployment
NODE_ENV=production
PORT=3000
PUBLIC_BACKEND_URL=https://your-render-backend.onrender.com

# Frontend CORS
# Comma-separated origins, no spaces. Example: https://your-vercel-frontend-url.vercel.app
CLIENT_ORIGINS=https://your-vercel-frontend-url.vercel.app

# Database
# Recommended for production. If omitted, the app falls back to SQLite on ephemeral Render disk.
DATABASE_URL=
POSTGRES_URL=
POSTGRES_SSL=true
SQLITE_DB_PATH=/tmp/legatrixon_db.sqlite

# Supabase server-side access
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DISABLED=false

# Vector database
QDRANT_URL=
QDRANT_API_KEY=

# AI providers
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Authentication
CLERK_SECRET_KEY=

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-render-backend.onrender.com/api/v1/exam/calendar/callback

# Email / SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SECURITY_EMAIL_FROM=

# Admin/security configuration
ADMIN_PORTAL_ID=
ADMIN_PORTAL_PASSWORD=
BYOK_ENCRYPTION_KEY=
PROVIDER_KEY_ENCRYPTION_KEY=
ADMIN_EMAILS=
FOUNDER_EMAILS=

# Optional services and tuning
REDIS_URL=
BGE_M3_SERVICE_URL=
LEARNING_INDEXING_CONCURRENCY=2
LEARNING_CHUNK_SIZE=1400
MAX_NOTEBOOK_UPLOAD_BYTES=26214400
MAX_LEARNING_UPLOAD_BYTES=26214400
