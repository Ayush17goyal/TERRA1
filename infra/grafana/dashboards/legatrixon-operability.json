    { "type": "timeseries", "title": "API P95/P99 Latency", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 }, "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(legatrixon_http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "p95 {{route}}" }, { "expr": "histogram_quantile(0.99, sum(rate(legatrixon_http_request_duration_seconds_bucket[5m])) by (le, route))", "legendFormat": "p99 {{route}}" }] },
