# LEGATRIXON Backend - Production Environment Variables
# Copy this to your deployment platform and fill in the values
# DO NOT commit secrets to version control

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
PUBLIC_BACKEND_URL=https://api.example.com

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Use PostgreSQL in production (never SQLite in production)
DATABASE_URL=postgresql://user:password@hostname:5432/legatrixon_db
# OR if using Supabase:
POSTGRES_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# SQLite fallback (disabled in production)
SQLITE_DB_PATH=/tmp/legatrixon_db.sqlite

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Browser-safe project URL/anon key (still restrict with RLS)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=<supabase-anon-key>

# This is secret - only in backend
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>

# Disable Supabase if not configured
SUPABASE_DISABLED=false

# ============================================================================
# VECTOR DATABASE (QDRANT) CONFIGURATION
# ============================================================================
# Use hosted Qdrant Cloud or self-hosted instance
QDRANT_URL=https://[cluster-name]-[api-port].qdrant.io
QDRANT_API_KEY=your-qdrant-api-key-here

# ============================================================================
# REDIS CONFIGURATION (Semantic Cache)
# ============================================================================
# Optional but recommended for caching and performance
REDIS_URL=redis://default:password@hostname:6379

# ============================================================================
# AI PROVIDER CONFIGURATION
# ============================================================================
# OpenRouter API Key (supports multiple models: Gemini, GPT-4o-mini, DeepSeek)
OPENROUTER_API_KEY=<openrouter-production-key>

# Alternative: Individual API keys (if using direct providers)
OPENAI_API_KEY=<openai-production-key>
GEMINI_API_KEY=<gemini-production-key>
DEEPSEEK_API_KEY=<deepseek-production-key>
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# ============================================================================
# AUTHENTICATION CONFIGURATION
# ============================================================================
# Clerk Authentication
CLERK_SECRET_KEY=<clerk-production-secret-key>
ADMIN_EMAILS=admin@example.com
ADMIN_PORTAL_ID=<non-secret-admin-id>
# Generate with: cd server && npm run admin:hash-secret
ADMIN_PORTAL_PASSWORD_HASH=<scrypt-hash>
# Independent random value (32+ characters) used only to sign short-lived admin sessions.
ADMIN_PORTAL_SESSION_SECRET=<password-manager-generated-random-secret>

# Global launch-safety default. The database row remains authoritative after first boot.
DEMO_LIMIT_PER_FEATURE_PER_DAY=4

# ============================================================================
# FILE UPLOAD CONFIGURATION
# ============================================================================
# Maximum file upload sizes (in bytes)
MAX_LEARNING_UPLOAD_BYTES=26214400          # 25MB per file
MAX_LEARNING_BULK_FILES=50                  # Maximum files per bulk upload
MAX_LEARNING_BULK_BYTES=157286400           # 150MB total for bulk upload

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
# Production: Use actual domain(s) here
# Format: "https://app.example.com,https://www.example.com"
CLIENT_ORIGINS=https://app.legatrixon.com,https://www.legatrixon.com
CLIENT_ORIGIN=https://app.legatrixon.com

# Development: Can be blank, defaults to localhost:5173
# CLIENT_ORIGINS=http://localhost:5173

# ============================================================================
# BACKGROUND JOBS CONFIGURATION
# ============================================================================
# Enable/disable background notification dispatcher
ENABLE_BACKGROUND_NOTIFICATION_DISPATCHER=true

# ============================================================================
# OPTIONAL: BGE-M3 EMBEDDING SERVICE
# ============================================================================
# If running your own sidecar (not recommended for MVP)
# BGE_M3_SERVICE_URL=http://localhost:8100
# Otherwise, embeddings are generated via OpenRouter or local service

# ============================================================================
# OBSERVABILITY & MONITORING
# ============================================================================
# Optional: Add monitoring/logging
# SENTRY_DSN=https://xxxx@sentry.io/xxxxx
# DD_API_KEY=xxxxx  # Datadog

# ============================================================================
# SECURITY HEADERS
# ============================================================================
# Recommendation: Use environment-specific values
TRUST_PROXY=true  # For use behind Fly.io proxy

# Payments
RAZORPAY_KEY_ID=<razorpay-production-key-id>
RAZORPAY_KEY_SECRET=<razorpay-production-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-production-webhook-secret>

# Upload malware scanning (required by production validation)
VIRUS_SCAN_MODE=required
VIRUS_SCAN_COMMAND=<scanner-command>

# Frontend deployment variables (configure on Vercel, not in backend runtime)
VITE_API_URL=https://api.example.com/api/v1
VITE_CLERK_PUBLISHABLE_KEY=<clerk-production-publishable-key>
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>
VITE_TURNSTILE_SITE_KEY=<cloudflare-turnstile-site-key>

